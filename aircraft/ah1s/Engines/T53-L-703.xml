<!--
  Avco Lycoming T53-L-703 turboshaft, AH-1S main rotor drive. Sources:
  [A] TM 1-1520-236-10 AH-1F operator's manual (2001) https://upload.wikimedia.org/wikipedia/commons/e/e1/TM-1-1520-236-10.pdf
  [B] TM 55-1520-236-10 AH-1S operator's manual (1980) https://archive.org/details/TM5515202361080AH1S
  [D] TM 55-1520-236-23-2 https://www.liberatedmanuals.com/TM-55-1520-236-23-2.pdf
  [E] USAAEFA 77-25 AH-1S (1980) https://archive.org/details/DTIC_ADA089625
  [G] DTIC ADA182369 UH-1H with T53-L-703 https://archive.org/details/DTIC_ADA182369
  Table RPM is the output shaft speed, rotor rpm x gearratio: 100 % N2 = 6600 rpm [D].
-->

<turboprop_engine name="T53-L-703">
  <maxpower unit="HP">          1800.0  </maxpower>         <!-- military, SL standard day [G] Table 1, [E] sec. 5 -->
  <idlen1>                        70.0  </idlen1>           <!-- idle 68-72 % [A] p. 8-9 -->
  <maxn1>                        106.0  </maxn1>            <!-- [A] para 5-7a(1), [G] Table 1 -->
  <psfc unit="LBS/HR/HP">          0.62 </psfc>             <!-- derived from [B] Fig 7-7: 695 lb/hr at 87 %Q of 1290 shp -->
  <n1idle_max_delay>               1.0  </n1idle_max_delay> <!-- engtm601.xml template, no T53 data -->
  <maxstartingtime>               20.0  </maxstartingtime>  <!-- engtm601.xml template, no T53 data -->
  <startern1>                     20.0  </startern1>        <!-- engtm601.xml template, no T53 data -->
  <itt_delay>                      0.05 </itt_delay>        <!-- engtm601.xml template, no T53 data -->

  <function name="EnginePowerVC">
